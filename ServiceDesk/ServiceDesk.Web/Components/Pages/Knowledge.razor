@page "/knowledge"
@using System.ComponentModel.DataAnnotations
@inject IKnowledgeClient KnowledgeClient
@inject NavigationManager Nav

<PageTitle>Knowledge Base</PageTitle>

<h1 class="mb-3">Knowledge Base</h1>

<EditForm Model="newArticle" OnValidSubmit="CreateAsync" class="card mb-3">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="card-body">
        <h5 class="card-title mb-3">New Article</h5>

        <div class="mb-2">
            <label class="form-label">Title</label>
            <InputText class="form-control" @bind-Value="newArticle.Title" />
        </div>

        <div class="mb-2">
            <label class="form-label">Content</label>
            <InputTextArea class="form-control" rows="5" @bind-Value="newArticle.Content" />
        </div>

        <button class="btn btn-primary" disabled="@creating">Create</button>

        @if (createError is not null)
        {
            <div class="alert alert-danger mt-2 mb-0">@createError</div>
        }
    </div>
</EditForm>

@if (loadError is not null)
{
    <div class="alert alert-danger" role="alert">@loadError</div>
}
else if (articles is null)
{
    <div class="text-muted">Loading…</div>
}
else if (articles.Count == 0)
{
    <div class="text-muted">No articles yet.</div>
}
else
{
    @foreach (var a in articles)
    {
        <details class="card mb-2">
            <summary class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">@a.Title</span>
                <span class="text-muted small">@a.UpdatedAt.ToString("yyyy-MM-dd")</span>
            </summary>

            <div class="card-body">
                <div class="text-muted small mb-2">Author: @a.AuthorUsername</div>

                <div style="white-space:pre-wrap">@a.Preview</div>

                <div class="mt-3 d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => NavigateToEdit(a.Id)">Edit</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(a.Id)">Delete</button>
                </div>

                @if (deleteErrorById.TryGetValue(a.Id, out var err))
                {
                    <div class="alert alert-danger mt-2 mb-0">@err</div>
                }
            </div>
        </details>
    }
}

@code {
    IReadOnlyList<ArticleSummaryDto>? articles;
    string? loadError;

    bool creating;
    string? createError;

    readonly Dictionary<Guid, string> deleteErrorById = new();

    NewArticleModel newArticle = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        try
        {
            loadError = null;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            articles = await KnowledgeClient.GetArticlesAsync(cts.Token);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    async Task CreateAsync()
    {
        creating = true;
        createError = null;

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var id = await KnowledgeClient.CreateArticleAsync(
                new CreateArticleDto(newArticle.Title.Trim(), newArticle.Content.Trim()),
                cts.Token);

            newArticle = new();
            await ReloadAsync();

            Nav.NavigateTo($"/knowledge/{id}/edit");
        }
        catch (Exception ex)
        {
            createError = ex.Message;
        }
        finally
        {
            creating = false;
        }
    }

    void NavigateToEdit(Guid id) => Nav.NavigateTo($"/knowledge/{id}/edit");

    async Task DeleteAsync(Guid id)
    {
        deleteErrorById.Remove(id);

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            await KnowledgeClient.DeleteArticleAsync(id, cts.Token);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            deleteErrorById[id] = ex.Message;
        }
    }

    sealed class NewArticleModel
    {
        [Required]
        [MinLength(3)]
        [MaxLength(200)]
        public string Title { get; set; } = string.Empty;

        [Required]
        [MinLength(10)]
        [MaxLength(20000)]
        public string Content { get; set; } = string.Empty;
    }
}
